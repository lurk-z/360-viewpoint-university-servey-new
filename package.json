{
  "name": "kmuntb-prachinburi-virtual-tour",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8360",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check": "npm run typecheck && npm run test && npm run check:legacy && npm run build"
  },
  "dependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "5.14.3",
    "@photo-sphere-viewer/core": "5.14.3",
    "@photo-sphere-viewer/markers-plugin": "5.14.3",
    "@photo-sphere-viewer/virtual-tour-plugin": "5.14.3",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
