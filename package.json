{
  "name": "kmuntb-prachinburi-virtual-tour",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 8360",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:cms": "node --experimental-strip-types scripts/seed-cms.ts",
    "bootstrap:tour": "node --experimental-strip-types scripts/bootstrap-tour-structure.ts",
    "sync:tour": "node --experimental-strip-types scripts/sync-tour.ts",
    "sync:arrows": "node --experimental-strip-types scripts/sync-arrows.ts",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "tour:add-scene": "node --experimental-strip-types scripts/tour-add-scene.ts",
    "check:workers": "node --check public/sw.js",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check": "npm run typecheck && npm run test && npm run check:workers && npm run check:legacy && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.16.0",
    "@photo-sphere-viewer/autorotate-plugin": "5.14.3",
    "@photo-sphere-viewer/core": "5.14.3",
    "@photo-sphere-viewer/markers-plugin": "5.14.3",
    "@photo-sphere-viewer/virtual-tour-plugin": "5.14.3",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "@tailwindcss/postcss": "4.3.3",
    "leaflet": "1.9.4",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "three": "0.184.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
