{
  "name": "kmuntb-prachinburi-virtual-tour",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8360",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check": "npm run typecheck && npm run test && npm run check:legacy && npm run build"
  },
  "dependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "5.14.3",
    "@photo-sphere-viewer/core": "5.14.3",
    "@photo-sphere-viewer/markers-plugin": "5.14.3",
    "@photo-sphere-viewer/virtual-tour-plugin": "5.14.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
